# Copie para .env (cp .env.example .env) e preencha. NUNCA commite o .env.

# --- Postgres (usado pelo container postgres) ---
POSTGRES_USER=voryx
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=voryx

# --- App ---
# Use a MESMA senha do POSTGRES_PASSWORD acima.
VORYX_DATABASE_URL=postgresql+asyncpg://voryx:TROQUE_POR_UMA_SENHA_FORTE@postgres:5432/voryx

# Chave que criptografa as sessions do Telegram. Gere com:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GUARDE UMA COPIA FORA DA VPS: sem ela as sessions salvas nao podem ser recuperadas.
VORYX_ENCRYPTION_KEY=

# Assina o cookie de login do painel. Gere com: openssl rand -hex 32
VORYX_SECRET_KEY=

VORYX_COOKIE_DOMAIN=.voryx.pro
VORYX_COOKIE_SECURE=true
VORYX_CORS_ORIGIN=https://painel.voryx.pro
VORYX_MAX_UPLOAD_MB=500
